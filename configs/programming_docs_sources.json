        "prog_swift_core": {"options":{"programming_language":"Swift","runtime":"Swift","include_prefixes":["/swift-book/"]}},
        "prog_dart_core": {"options":{"programming_language":"Dart","runtime":"Dart","license_name":"CC BY 4.0 / BSD-3-Clause samples"}},
        "prog_dart_api": {"options":{"programming_language":"Dart","runtime":"Dart SDK API"}},
